From 2db393437e101f3271db237b4700e253114efb61 Mon Sep 17 00:00:00 2001
From: Patryk Kups <pkups@anaconda.com>
Date: Tue, 9 Dec 2025 19:29:55 +0100
Subject: [PATCH 6] also link to static absl_flags_* on windows

---
 python/setup.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/python/setup.py b/python/setup.py
index 867a924..bab7e66 100755
--- a/python/setup.py
+++ b/python/setup.py
@@ -180,8 +180,17 @@ class build_ext_win(_build_ext):
           '/std:c++17',
           #'/I' + os.path.normpath('..\\build\\root\\include'),
           '/MD',
+          '/DPROTOBUF_USE_DLLS',
           '/I' + os.environ["LIBRARY_INC"]
       ] + get_protobuf_includes()
+      # most of abseil can be built as shared, which ends up in one giant library
+      # called abseil_dll; the absl_flags_* libraries always stay static
+      absl_libs = [
+          "abseil_dll", "absl_log_flags", "absl_flags_commandlineflag", "absl_flags_commandlineflag_internal",
+          "absl_flags_config", "absl_flags_internal", "absl_flags_marshalling", "absl_flags_parse",
+          "absl_flags_private_handle_accessor", "absl_flags_program_name", "absl_flags_reflection",
+          "absl_flags_usage", "absl_flags_usage_internal",
+      ]
       libs = [
           #'..\\build\\root\\lib\\sentencepiece.lib',
           #'..\\build\\root\\lib\\sentencepiece_train.lib',

From d75cae0c1946a8a41f28432e903f72c65c94ccf2 Mon Sep 17 00:00:00 2001
From: Andrey Vetroumov <avetroumov@anaconda.com>
Date: Wed, 23 Sep 2026 09:30:31 +0000
Subject: [PATCH] also install pkg config files on windows

---
 CMakeLists.txt | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b831501..8369e05 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -168,9 +168,10 @@ set(INSTALL_DATADIR ${datadir_for_config_file})
 configure_file("${PROJECT_SOURCE_DIR}/config.h.in" "config.h")
 configure_file("${PROJECT_SOURCE_DIR}/sentencepiece.pc.in" "sentencepiece.pc" @ONLY)
 
-if (NOT MSVC)
+#if (NOT MSVC)
   # suppress warning for C++11 features.
   # add_definitions("-Wno-deprecated-declarations -Wno-deprecated-enum-enum-conversion")
+if (TRUE)
   install(FILES "${CMAKE_CURRENT_BINARY_DIR}/sentencepiece.pc" DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
 endif()
 
